# ---- Общие ----
NOTION_TOKEN=
# NOTION_API_KEY=            # альтернатива NOTION_TOKEN (fallback)
TZ=Europe/Minsk
LOG_LEVEL=INFO
DRY_RUN=false
ENABLE_CURRENCY=true
ENABLE_CRYPTO=true
ENABLE_HABITS=true

# ---- Валюты (ENABLE_CURRENCY=true) ----
CURRENCY_DATABASE_ID=
CURRENCY_CODE_FIELD=ID_money
CURRENCY_RATE_FIELD=Money_rate
CURRENCY_UPDATE_HOURS=2
CURRENCY_CRON=
CURRENCY_CITY=Минск

# ---- Крипта (ENABLE_CRYPTO=true) ----
CRYPTO_DATABASE_ID=
CRYPTO_SYMBOL_FIELD=Symbol
CRYPTO_PRICE_FIELD=Price
CRYPTO_UPDATED_FIELD=Last Updated
CRYPTO_YESTERDAY_PRICE_FIELD=Price (Yesterday)
CRYPTO_CHUNK_SIZE=200
CRYPTO_UPDATE_SECONDS=300
CRYPTO_CRON=

# ---- Привычки (ENABLE_HABITS=true) ----
HABITS_DATABASE_ID=
HABITS_LIST=Курение,Алкоголь,Газировка,Кофе,Переедание,Мучное,Сахар,Сладкое
HABITS_NAME_FIELD=Название
HABITS_COUNTER_FIELD=Срок [P]
HABITS_INCREMENT_TIME=22:00
